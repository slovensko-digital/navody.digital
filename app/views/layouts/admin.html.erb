<!DOCTYPE html>
<html>
  <head>
    <title>ADMIN</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_pack_tag 'admin' %>
    <%= stylesheet_pack_tag 'application' %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'admin', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="govuk-template__body">
  <script>
    document.body.classList.add('js-enabled');
    if ('noModule' in HTMLScriptElement.prototype) document.body.classList.add('govuk-frontend-supported');
  </script>
  <a href="#main-content" class="govuk-skip-link">Skip to main content</a>

  <header class="govuk-template__header">
    <div class="govuk-generic-header">
      <div class="govuk-generic-header__container govuk-width-container">
        <div class="govuk-generic-header__logo">
          <a href="/" class="govuk-generic-header__homepage-link">
            <span class="govuk-header__product-name">navody.digital</span>
          </a>
        </div>
      </div>
    </div>

    <section aria-label="Admin" class="govuk-service-navigation" data-module="govuk-service-navigation">
      <div class="govuk-width-container">
        <div class="govuk-service-navigation__container">
          <span class="govuk-service-navigation__service-name">
            <%= link_to 'Admin', admin_root_path, class: 'govuk-service-navigation__link' %>
          </span>
          <nav aria-label="Menu" class="govuk-service-navigation__wrapper">
            <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="navigation" hidden aria-hidden="true">Menu</button>
            <ul class="govuk-service-navigation__list" id="navigation">
              <% [
                ['Featured on front page', admin_documents_path, current_page?(admin_documents_path) && 'page'],
                ['Pages', admin_pages_path, current_page?(admin_pages_path) && 'page'],
                ['Journeys', admin_journeys_path, current_page?(admin_journeys_path) && 'page'],
                ['Apps', admin_apps_path, current_page?(admin_apps_path) && 'page'],
                ['UserJourneys', admin_user_journeys_path, current_page?(admin_user_journeys_path) && 'page'],
                ['Uploads', admin_uploads_path, current_page?(admin_uploads_path) && 'page'],
                ['CurrentTopics', admin_current_topics_path, request.fullpath.include?(admin_current_topics_path) && 'true'],
                ['Categories', admin_categories_path, current_page?(admin_categories_path) && 'page'],
                ['Good Job', '/admin/good_job', false]
              ].each do |text, path, active| %>
                <li class="govuk-service-navigation__item<%= ' govuk-service-navigation__item--active' if active %>">
                  <% if active %>
                    <%= link_to path, class: 'govuk-service-navigation__link', 'aria-current': active do %>
                      <strong class="govuk-service-navigation__active-fallback"><%= text %></strong>
                    <% end %>
                  <% else %>
                    <%= link_to text, path, class: 'govuk-service-navigation__link' %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </nav>
        </div>
      </div>
    </section>
  </header>

  <div class="govuk-width-container">
    <main class="govuk-main-wrapper " id="main-content" role="main">
      <%= yield %>
    </main>
  </div>

  <footer class="govuk-footer " role="contentinfo">
    <div class="govuk-width-container ">
      <div class="govuk-footer__meta">
        <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">

          <svg role="presentation" focusable="false" class="govuk-footer__licence-logo" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 483.2 195.7" height="17" width="41">
            <path fill="currentColor" d="M421.5 142.8V.1l-50.7 32.3v161.1h112.4v-50.7zm-122.3-9.6A47.12 47.12 0 0 1 221 97.8c0-26 21.1-47.1 47.1-47.1 16.7 0 31.4 8.7 39.7 21.8l42.7-27.2A97.63 97.63 0 0 0 268.1 0c-36.5 0-68.3 20.1-85.1 49.7A98 98 0 0 0 97.8 0C43.9 0 0 43.9 0 97.8s43.9 97.8 97.8 97.8c36.5 0 68.3-20.1 85.1-49.7a97.76 97.76 0 0 0 149.6 25.4l19.4 22.2h3v-87.8h-80l24.3 27.5zM97.8 145c-26 0-47.1-21.1-47.1-47.1s21.1-47.1 47.1-47.1 47.2 21 47.2 47S123.8 145 97.8 145"/>
          </svg>
          <span class="govuk-footer__licence-description">
            All content is available under the
            <a class="govuk-footer__link" href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" rel="license">Open Government Licence v3.0</a>, except where otherwise stated
          </span>
        </div>
        <div class="govuk-footer__meta-item">
          <a class="govuk-footer__link govuk-footer__copyright-logo" href="https://www.nationalarchives.gov.uk/information-management/re-using-public-sector-information/uk-government-licensing-framework/crown-copyright/">© Crown copyright</a>
        </div>
      </div>
    </div>
  </footer>
  </body>
</html>
